# Copy this file to `.env` and fill in your values.
# The Supabase anon/publishable key is a CLIENT key and is safe to ship in the
# app bundle — it is NOT a secret. Real protection comes from Row Level Security
# (see supabase/security/rls_and_storage.sql). Never put the service_role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key
